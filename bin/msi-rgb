#!/usr/bin/env bash
set -euo pipefail

# MSI Mystic Light Native Linux RGB Controller Launcher
# Directly communicates with hardware via Linux HID.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Direct execution of MSI Mystic Light Native RGB Controller

# Always incrementally build latest changes into release binary
cargo build --release --manifest-path "${PROJECT_ROOT}/Cargo.toml"

exec "${PROJECT_ROOT}/target/release/msi-rgb" "$@"
